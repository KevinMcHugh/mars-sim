# Sample alien name pool.
#
# A rolled AlienSpecies (see docs/lore.md) needs a name -- what colonists
# call it -- and which names make sense depends on how it rolled: a
# six-legged armored thing reads as a "beetle," a limbless scaly one as a
# "snake." Each entry below is a candidate name plus a `when` condition over
# the species' build; every entry whose condition matches the rolled species
# is a candidate, and one is picked at random among them, so overlapping
# conditions (a name that fits several kinds of species) are expected, not an
# error. An entry with no `when` always applies.
#
# Copy this file to alien-names.yaml (or run with -alien-names
# alien-names.yaml.example) to try it. Nothing loads it automatically under
# this name -- the game's built-in pool (compiled in from
# internal/sim/alien-names.yaml) is used unless a file is named.
#
# Condition fields:
#   temperament: friendly | cautious | hostile
#   skin:        smooth | scaly | furry | armored | bony | chitinous | slimy
#   color:       red | orange | yellow | green | blue | purple | gray | black | white | pale | iridescent
#   pattern:     solid | striped | spotted   (how the color is laid out)
#   height:      tiny | small | average | large | huge   (bucketed from the rolled range)
#   weight:      tiny | small | average | large | huge   (bucketed from the rolled range)
#   tail:        true | false
#   legs / arms / limbs / eyes:  {eq: N} | {gt: N} | {gte: N} | {lt: N} | {lte: N}
#
# Combine with "all" (every sub-condition must match), "any" (at least one
# must), and "not" (must not match) -- these nest to any depth.
#
# emoji is an optional list of candidate glyphs for the name: a species that
# lands on this entry also draws one of these at random. It's a plain string
# as far as this file (and the sim) is concerned -- always safe as flavor
# text in the roster and lore tab -- but the TUI's map tile only draws it if
# the exact string matches one of its own vetted, registered glyphs
# (internal/ui/tui/glyphs.go); anything else falls back to the plain alien
# glyph there. Stick to the emoji already used in internal/sim/alien-names.yaml
# if you want your own names to show up on the map too.

names:
  # Unconditional fallbacks: always eligible, whatever the species rolled.
  - name: alien
    plural: aliens
    emoji: ["👽"]
  - name: xeno
    plural: xenos
    emoji: ["👽", "🛸"]

  # A compound condition: exactly six legs *and* armored skin.
  - name: beetle
    plural: beetles
    emoji: ["🪲"]
    when:
      all:
        - legs: { eq: 6 }
        - skin: armored

  # "any": either a passive temperament reads as this name.
  - name: critter
    plural: critters
    emoji: ["👾", "🐛"]
    when:
      any:
        - temperament: friendly
        - temperament: cautious

  # "not": a hostile, two-legged species that does *not* have a tail --
  # something that could pass for upright and humanoid. No emoji candidates
  # here on purpose: it just falls back to the plain alien glyph on the map,
  # which is a perfectly normal thing for an entry to do.
  - name: stalker
    plural: stalkers
    when:
      all:
        - temperament: hostile
        - legs: { eq: 2 }
        - not:
            tail: true
